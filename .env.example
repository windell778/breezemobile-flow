# ─── Data source ──────────────────────────────────────────────────────────────
# "mock"    → uses lib/mock-data.ts (default for local dev)
# "posthog" → uses PostHog API (requires credentials below)
DATA_SOURCE=mock

# ─── Workspace (single-tenant V0) ─────────────────────────────────────────────
# Identifier for the current client workspace.
# Used as a prefix in R2 storage keys and to scope all queries.
WORKSPACE_ID=breezemobile

# ─── PostHog (server-side only — never expose in the browser) ─────────────────
# Project ID:  Settings → Project → General → Project ID
# API Key:     Settings → Project → API Keys → Personal API key (not the project key)
# Host:        your PostHog region endpoint
POSTHOG_PROJECT_ID=415134
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Webhook secret (optional but recommended).
# Set this value in PostHog when configuring the recording webhook,
# then add it here. The webhook handler will verify the signature.
POSTHOG_WEBHOOK_SECRET=

# ─── Cloudflare R2 object storage (server-side only) ──────────────────────────
# Used to store rrweb session recording events after PostHog webhook fires.
# Account ID:      Cloudflare dashboard → R2 → Account ID
# Access Key ID:   R2 → Manage API Tokens → Create API Token (Object Read & Write)
# Secret:          same API token creation flow
# Bucket name:     name of the R2 bucket you created
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=breezemobile-recordings
